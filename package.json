{
  "name": "pobratymy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pobratymy/web dev",
    "dev:web": "pnpm --filter @pobratymy/web dev",
    "dev:studio": "pnpm --filter @pobratymy/studio dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @pobratymy/web build",
    "build:studio": "pnpm --filter @pobratymy/studio build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
